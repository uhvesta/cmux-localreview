module(
    name = "cmux_localreview",
    version = "0.2.0",
)

bazel_dep(name = "rules_go", version = "0.59.0")
bazel_dep(name = "gazelle", version = "0.47.0")

# Gazelle's Bzlmod plugin references this repository explicitly with Bazel
# 1.8.x; declaring it keeps `bazel run @gazelle//:gazelle` resolvable.
bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "bazel_skylib_gazelle_plugin", version = "1.4.1")

go = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go.download(version = "1.26.0")

# Generated from go.mod. Keep this explicit: Bazel releases must not run Go's
# networked module resolver at compile time.
go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(
    go_deps,
    "com_github_github_copilot_sdk_go",
    "org_modernc_sqlite",
)
