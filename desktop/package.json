{
  "name": "cmux-localreview-desktop",
  "version": "0.1.0",
  "description": "Local-first review queue for cmux and Copilot",
  "author": "cmux-localreview contributors",
  "private": true,
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "dev": "LOCALREVIEWD_PATH=../bazel-bin/cmd/localreviewd/localreviewd_/localreviewd electron .",
    "check": "node --check main.mjs",
    "package": "electron-builder",
    "package:dir": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "40.10.6",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.uhvesta.cmuxlocalreview",
    "productName": "CMUX Local Review",
    "files": ["main.mjs", "package.json"],
    "extraResources": [{ "from": "../bazel-bin/cmd/localreviewd/localreviewd_/localreviewd", "to": "localreviewd" }]
  }
}
